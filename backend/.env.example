DATABASE_URL=mysql+pymysql://toeic:toeic123@127.0.0.1:3307/toeic_studio?charset=utf8mb4
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_BEFORE_DEPLOYING
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ENABLE_LANGUAGETOOL=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional initial content-administrator account. Leave blank to disable bootstrap.
# Generate a unique ADMIN_PASSWORD (at least 12 characters) and ADMIN_JWT_SECRET (32+ characters).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=
# local keeps uploaded images/audio in backend/uploads/; s3 supports AWS S3 or Cloudflare R2.
MEDIA_STORAGE_PROVIDER=local
MEDIA_LOCAL_DIR=
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_PUBLIC_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Local CPU speaking model controls, no GPU and no paid API required:
SPEAKING_WHISPER_MODEL=tiny.en
SPEAKING_E2E_MAX_WORDS=8
SPEAKING_VERIFY_PHONEMES=false
# Optional semantic content grading ONLY (requires working Gemini free-tier key):
SPEAKING_CONTENT_AI=false
# Optional real GOPT sidecar (Docker + Kaldi); see README:
GOPT_WEB_URL=
GOPT_TIMEOUT_SECONDS=100
